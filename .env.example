# ── Servidor Express ───────────────────────────────────────────────────────
PORT=8788

# ── Modo de datos: mock | live ──────────────────────────────────────────────
# mock:  Desarrollo y pruebas offline con fixtures (sin VPN ni certificados).
# live:  Conexión real con GLPI y jTraspaso mediante Playwright + certificado FNMT.
DATA_MODE=live

# ── Opciones de Navegador Playwright (Modo LIVE) ───────────────────────────
# HEADLESS=true   -> Ejecuta Firefox en segundo plano sin ventana gráfica.
# HEADLESS=false  -> Abre la ventana de Firefox para supervisar la interacción.
HEADLESS=false

# Solo para diagnostico local cuando exista un certificado de desarrollo no confiable.
# En LIVE debe mantenerse desactivado.
IGNORE_HTTPS_ERRORS=false
