# ── jTraspaso (SQL Server) ─────────────────────────────────────────────────
# Copia este fichero a ".env" y rellena los valores reales.
JTRAS_SERVER=servidor-sql.ejemplo.es
JTRAS_DATABASE=jTraspaso
JTRAS_USER=usuario_sql
JTRAS_PASSWORD=contraseña_sql
JTRAS_PORT=1433
# JTRAS_ENCRYPT=true         (por defecto true)
# JTRAS_TRUST_CERT=false     (pon true si el cert. del server es autofirmado)

# ── Servidor Express ───────────────────────────────────────────────────────
PORT=8788
